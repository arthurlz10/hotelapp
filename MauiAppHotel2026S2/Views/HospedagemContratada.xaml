<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.HospedagemContratada"
             Title="Resumo da hospedagem"
             BackgroundColor="#F2F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <VerticalStackLayout Spacing="5">
                <Label Text="HOTEL HORIZONTE"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#234A72"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Resumo da hospedagem"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="#18324D"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Confira os dados da sua reserva."
                       FontSize="13"
                       TextColor="#666666"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="2"
                     Color="#234A72"/>

            <VerticalStackLayout Spacing="14">

                <Label Text="Dados da hospedagem"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#18324D"/>

                <Label Text="{Binding QuartoEscolhido.Nome}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#234A72"/>

                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="14">

                    <Label Text="Quantidade de diárias"
                           TextColor="#555555"/>

                    <Label Grid.Column="1"
                           Text="{Binding Estadia, StringFormat='{0} diária(s)'}"
                           TextColor="#18324D"
                           FontAttributes="Bold"/>

                    <Label Grid.Row="1"
                           Text="Adultos"
                           TextColor="#555555"/>

                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding QntAdultos}"
                           TextColor="#18324D"
                           FontAttributes="Bold"/>

                    <Label Grid.Row="2"
                           Text="Crianças"
                           TextColor="#555555"/>

                    <Label Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding QntCriancas}"
                           TextColor="#18324D"
                           FontAttributes="Bold"/>

                    <Label Grid.Row="3"
                           Text="Check-in"
                           TextColor="#555555"/>

                    <Label Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding DataCheckin, StringFormat='{0:dd/MM/yyyy}'}"
                           TextColor="#18324D"
                           FontAttributes="Bold"/>

                    <Label Grid.Row="4"
                           Text="Check-out"
                           TextColor="#555555"/>

                    <Label Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding DataCheckout, StringFormat='{0:dd/MM/yyyy}'}"
                           TextColor="#18324D"
                           FontAttributes="Bold"/>

                </Grid>

            </VerticalStackLayout>

            <BoxView HeightRequest="1"
                     Color="#D5DDE5"/>

            <VerticalStackLayout Spacing="8">
                <Label Text="Valor total da hospedagem"
                       FontSize="15"
                       TextColor="#555555"
                       HorizontalTextAlignment="Center"/>

                <Label Text="{Binding TotalHospedagem, StringFormat='{}{0:C2}'}"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="#234A72"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Button Text="Voltar para reservas"
                    Clicked="Voltar_Clicked"
                    BackgroundColor="#234A72"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"/>

            <Label Text="Hotel Horizonte - 2026"
                   FontSize="11"
                   TextColor="#777777"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
