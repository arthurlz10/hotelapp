
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.ContratacaoHospedagem"
             Title="Reservar"
             BackgroundColor="#F2F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label Text="HOTEL HORIZONTE"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#18324D"
                   HorizontalOptions="Center"/>

            <Label Text="Faça sua reserva"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#234A72"/>

            <BoxView HeightRequest="2"
                     Color="#234A72"/>

            <Label Text="Quantidade de hóspedes"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#18324D"/>

            <!-- ADULTOS -->

            <Grid ColumnDefinitions="*,55,55,55"
                  ColumnSpacing="8">

                <Label Text="Adultos"
                       Grid.Column="0"
                       VerticalOptions="Center"
                       TextColor="#18324D"
                       FontSize="16"/>

                <Button Text="−"
                        Grid.Column="1"
                        Clicked="DiminuirAdultos_Clicked"
                        BackgroundColor="#234A72"
                        TextColor="White"
                        FontSize="22"
                        CornerRadius="8"/>

                <Label x:Name="lbl_adultos"
                       Text="1"
                       Grid.Column="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="18"
                       TextColor="#18324D"/>

                <Button Text="+"
                        Grid.Column="3"
                        Clicked="AumentarAdultos_Clicked"
                        BackgroundColor="#234A72"
                        TextColor="White"
                        FontSize="22"
                        CornerRadius="8"/>

            </Grid>

            <!-- CRIANCAS -->

            <Grid ColumnDefinitions="*,55,55,55"
                  ColumnSpacing="8">

                <Label Text="Crianças"
                       Grid.Column="0"
                       VerticalOptions="Center"
                       TextColor="#18324D"
                       FontSize="16"/>

                <Button Text="−"
                        Grid.Column="1"
                        Clicked="DiminuirCriancas_Clicked"
                        BackgroundColor="#234A72"
                        TextColor="White"
                        FontSize="22"
                        CornerRadius="8"/>

                <Label x:Name="lbl_criancas"
                       Text="0"
                       Grid.Column="2"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="18"
                       TextColor="#18324D"/>

                <Button Text="+"
                        Grid.Column="3"
                        Clicked="AumentarCriancas_Clicked"
                        BackgroundColor="#234A72"
                        TextColor="White"
                        FontSize="22"
                        CornerRadius="8"/>

            </Grid>

            <BoxView HeightRequest="1"
                     Color="#C5D0DC"/>

            <Label Text="Escolha sua acomodação"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#18324D"/>

            <Picker x:Name="pck_quarto"
                    Title="Selecione um quarto"
                    ItemDisplayBinding="{Binding Nome}"
                    TextColor="#18324D"
                    BackgroundColor="White"/>

            <BoxView HeightRequest="1"
                     Color="#C5D0DC"/>

            <Label Text="Data de check-in"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#18324D"/>

            <DatePicker x:Name="dtpck_checkin"
                        DateSelected="dtpck_checkin_DateSelected"
                        Format="dd/MM/yyyy"
                        TextColor="#18324D"/>

            <Label Text="Data de check-out"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#18324D"/>

            <DatePicker x:Name="dtpck_checkout"
                        Format="dd/MM/yyyy"
                        TextColor="#18324D"/>

            <Button Text="CONFIRMAR RESERVA"
                    Clicked="Button_Clicked"
                    BackgroundColor="#234A72"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="55"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
